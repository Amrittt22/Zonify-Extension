# Dev defaults for `docker compose up`. Copy to `.env` (gitignored).
# Mock mode needs no API key and returns a canned insight built from your numbers.
PORT=8787
MOCK_LLM=true
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
MODEL=claude-haiku-5-5

# For a real provider, set MOCK_LLM=false and uncomment:
# ANTHROPIC_API_KEY=sk-ant-...

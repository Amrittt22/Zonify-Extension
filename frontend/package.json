{
  "name": "zonify-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zonify - Pomodoro timer and site blocker. Get in the zone.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit && vite build",
    "package": "npm run build && npm run verify:dist && powershell -NoProfile -ExecutionPolicy Bypass -Command \"Compress-Archive -Force -Path 'dist\\*' -DestinationPath 'zonify.zip'\""
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^2.1.8"
  }
}

# --- Server ---------------------------------------------------------------
# Port the API listens on.
PORT=8787

# --- LLM provider ---------------------------------------------------------
# Required unless MOCK_LLM=true. Never commit the real key.
ANTHROPIC_API_KEY=
# Model to use for insight generation.
MODEL=claude-haiku-5-5

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins, e.g.:
#   ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
# Leave empty to allow requests without an Origin header only (recommended
# while developing with curl).
ALLOWED_ORIGINS=

# --- Networking -----------------------------------------------------------
# Set to true when running behind a reverse proxy / platform (Render,
# Railway, Fly, nginx) so rate limits see the real client IP.
TRUST_PROXY=false

# --- Rate limits ----------------------------------------------------------
# Per-IP requests per hour (checked BEFORE body validation).
IP_LIMIT_PER_HOUR=30
# Max insight generations per installId per calendar day.
DAILY_LIMIT_PER_INSTALL=5
# Global cap on model calls per calendar day (protects the API spend).
GLOBAL_DAILY_LIMIT=500

# --- Development ----------------------------------------------------------
# When true, return a canned insight built from the request numbers without
# calling the provider (no API key needed). Never enable in production.
MOCK_LLM=false

{
  "name": "zonify-backend",
  "version": "1.0.0",
  "description": "Privacy-preserving insights API between the Zonify Chrome extension and the LLM provider.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
